rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================
    // LOCALBAZER PRODUCTION CLOUD FIRESTORE SECURITY RULES
    // Master Full-Access for LocalBazar Operations & Lifetime Safety
    // ========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Listings Collection (Shops, Doctors, Clinics, Stores)
    match /listings/{listingId} {
      allow read, write: if true;
    }

    // 2. Users Collection (Customer & Merchant Profiles)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 3. Store Reviews & Ratings
    match /reviews/{storeId}/items/{reviewId} {
      allow read, write: if true;
    }

    // 4. Live Merchant Inbox & Customer Chat
    match /inquiries/{storeId}/messages/{messageId} {
      allow read, write: if true;
    }

    // 5. Cities & Categories
    match /cities/{cityId} {
      allow read, write: if true;
    }
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 6. News, Promotional Ads & Banner Ads
    match /news/{newsId} {
      allow read, write: if true;
    }

    // 7. Platform Settings (Admin Security Protected & Public Settings)
    match /settings/{settingId} {
      allow read: if settingId != 'admin_security' || isAuthenticated();
      allow write: if settingId != 'admin_security' || isAuthenticated();
    }

    // 8. Business Claims & Trust Badge Verification Requests
    match /claims/{claimId} {
      allow read, write: if true;
    }
    match /trust_requests/{requestId} {
      allow read, write: if true;
    }

    // 9. Admin Mailbox & In-App Alerts
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // 10. City & Category Community Requests
    match /city_requests/{reqId} {
      allow read, write: if true;
    }
    match /category_requests/{reqId} {
      allow read, write: if true;
    }

    // Fallback Catch-All
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
