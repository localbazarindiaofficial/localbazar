rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Authenticated User check
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Listings Collection (Shops, Doctors, Clinics, Stores)
    match /listings/{listingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 2. Users Collection (Customer & Merchant Profiles)
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 3. Store & Product Reviews
    match /reviews/{storeId}/items/{reviewId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 4. Customer Chat & Inquiries
    match /inquiries/{storeId}/messages/{messageId} {
      allow read, write: if true;
    }
    match /inbox/{storeId}/threads/{threadId} {
      allow read, write: if true;
    }

    // 5. Cities & Categories
    match /cities/{cityId} {
      allow read: if true;
      allow write: if true;
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Home Slide Banners & Offers
    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Platform Settings & Admin Security
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Business Claims & Trust Badge Verification Requests
    match /claims/{claimId} {
      allow read, write: if true;
    }
    match /trust_requests/{requestId} {
      allow read, write: if true;
    }

    // 9. Admin Mailbox & In-App Alerts
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // 10. Community City & Category Requests
    match /city_requests/{reqId} {
      allow read, write: if true;
    }
    match /category_requests/{reqId} {
      allow read, write: if true;
    }

    // 11. Fallback Catch-All
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
