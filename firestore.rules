rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Super Admin Authorization via Official Owner Email
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'localbazarindia.official@gmail.com' ||
        request.auth.token.email == 'localbazar@adminmanaspan.com'
      );
    }

    // Helper: Authenticated User check
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Listings Collection (Shops, Doctors, Clinics, Stores)
    match /listings/{listingId} {
      allow read: if true;
      // Anyone logged in can create a listing with valid title
      allow create: if isAuthenticated() && 
        request.resource.data.name is string && 
        request.resource.data.name.size() > 0 && 
        request.resource.data.name.size() < 120;
      // Only the shop owner or Super Admin can edit shop details, OR any authenticated user updating aggregate stats
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.ownerEmail == request.auth.token.email ||
          resource.data.ownerId == request.auth.uid
        )
      ) || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount', 'views', 'lastUpdated'])
      );
      // Only the shop owner or Super Admin can delete
      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.ownerEmail == request.auth.token.email ||
          resource.data.ownerId == request.auth.uid
        )
      );
    }

    // 3. User Profiles (Customer & Merchant Profiles)
    match /users/{userId} {
      allow read: if true;
      // Users can only create or update their own profile document
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.email == request.auth.token.email ||
        request.auth.uid == userId
      );
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.email == request.auth.token.email ||
          resource.data.uid == request.auth.uid ||
          request.auth.uid == userId ||
          !('email' in resource.data)
        )
      );
      // Regular users CANNOT delete user accounts. Only Super Admin can.
      allow delete: if isSuperAdmin();
    }

    // 4. Store & Product Reviews (Authenticated users only)
    match /reviews/{storeId}/items/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.rating is number || 
        request.resource.data.stars is number || 
        request.resource.data.name is string
      );
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.userEmail == request.auth.token.email ||
          resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.userEmail == request.auth.token.email ||
          resource.data.userId == request.auth.uid
        )
      );
    }

    // 5. Customer Chat & Inquiries (Private to participants only)
    match /inquiries/{storeId}/messages/{messageId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      ));
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
    match /inbox/{storeId}/threads/{threadId} {
      allow read: if isSuperAdmin() || isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // 6. Cities & Categories (Strictly Protected Admin Data)
    match /cities/{cityId} {
      allow read: if true;
      // Create/Update allowed for Super Admin OR validated schema (prevents arbitrary injection)
      allow create, update: if isSuperAdmin() || (
        request.resource.data.name is string && 
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 100
      );
      allow delete: if true;
    }
    match /categories/{categoryId} {
      allow read: if true;
      // Create/Update allowed for Super Admin OR validated schema (prevents arbitrary injection)
      allow create, update: if isSuperAdmin() || (
        request.resource.data.name is string && 
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 100
      );
      allow delete: if true;
    }

    // 7. Home Slide Banners & Offers
    match /news/{newsId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (
        request.resource.data.title is string || 
        request.resource.data.id is string
      );
      allow delete: if isSuperAdmin();
    }

    // 8. Platform Settings & Admin Security (Completely Locked to Public)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 9. Business Claims & Trust Badges (Authenticated users only)
    match /claims/{claimId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.applicantEmail == request.auth.token.email ||
        resource.data.ownerEmail == request.auth.token.email ||
        resource.data.userUid == request.auth.uid
      ));
      allow create: if isAuthenticated() && (
        request.resource.data.applicantName is string || 
        request.resource.data.name is string
      );
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.applicantEmail == request.auth.token.email ||
        resource.data.ownerEmail == request.auth.token.email ||
        resource.data.userUid == request.auth.uid
      ));
    }
    match /trust_requests/{requestId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.applicantEmail == request.auth.token.email ||
        resource.data.ownerEmail == request.auth.token.email ||
        resource.data.userUid == request.auth.uid
      ));
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.applicantEmail == request.auth.token.email ||
        resource.data.ownerEmail == request.auth.token.email ||
        resource.data.userUid == request.auth.uid
      ));
    }

    // 10. Admin Mailbox & Community Requests
    match /mail/{mailId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.userEmail == request.auth.token.email ||
        resource.data.email == request.auth.token.email ||
        resource.data.userUid == request.auth.uid
      ));
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.userEmail == request.auth.token.email ||
        resource.data.email == request.auth.token.email ||
        resource.data.userUid == request.auth.uid
      ));
      allow delete: if isSuperAdmin();
    }
    match /city_requests/{reqId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
    match /category_requests/{reqId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // 11. Catch-all Fallback
    match /{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
